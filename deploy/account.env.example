# 本机单账户部署用（勿提交真实文件）
# 复制为 mail-worker/.env.account 或 export 后执行 scripts/deploy-one-account.sh

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

NAME=cloud-mail
DOMAIN=["example.com"]
ADMIN=admin@example.com
JWT_SECRET=

# 可选
# CUSTOM_DOMAIN=mail.example.com
# D1_DATABASE_ID=
# KV_NAMESPACE_ID=
# R2_BUCKET_NAME=

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ZeptoMail 发信（与 AwsMailPanel 同步；与 AWS 二选一）
# SEND_PROVIDER=zeptomail
# ZEPTOMAIL_TOKEN=
# ZEPTOMAIL_FROM=noreply@example.com
